# Copy to .env for local Spring Boot runs, or export the same variables in your shell.
#
# Local iam-server issuer/API root.
IAM_ENDPOINT=http://localhost:30001

# WEB or M2M confidential ApplicationClient.clientId for this Spring Boot API.
# Do not use the React SPA public client here.
IAM_CLIENT_ID=iam_web_or_m2m_confidential_client_id

# One-time secret for the WEB/M2M confidential ApplicationClient.
# Keep real values local and never commit them.
IAM_CLIENT_SECRET=replace_with_local_confidential_client_secret

# Optional local API port.
SERVER_PORT=8080
